[Unit]
Description=Bot Discord du bonjour quotidien
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bot
Group=bot
WorkingDirectory=/home/bot/app/botdujour
EnvironmentFile=/home/bot/app/botdujour/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bot/app/botdujour/.venv/bin/python /home/bot/app/botdujour/bot.py --config /home/bot/app/botdujour/config.json
Restart=on-failure
RestartSec=15
StateDirectory=botdujour
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/botdujour

[Install]
WantedBy=multi-user.target
