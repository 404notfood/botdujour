[Unit]
Description=Bot Discord du bonjour quotidien
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=bot
Group=bot
WorkingDirectory=/home/bot/app
EnvironmentFile=/home/bot/app/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/bot/app/.venv/bin/python /home/bot/app/bot.py --config /home/bot/app/config.json
Restart=on-failure
RestartSec=15
StateDirectory=botdujour
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/botdujour /home/bot/app/data

[Install]
WantedBy=multi-user.target
